# ---------------------------------------------------------------------------
# Copier ce fichier en « .env » puis remplacer les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est dans .gitignore).
# ---------------------------------------------------------------------------

# Clé secrète Django : générer une valeur unique avec
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---------------------------------------------------------------
# Utilisés par docker-compose.yml pour créer la base :
POSTGRES_DB=edenboutique
POSTGRES_USER=eden
POSTGRES_PASSWORD=change-me
# Connexion utilisée par Django (installation sans Docker) :
DATABASE_URL=postgres://eden:change-me@localhost:5432/edenboutique

# --- Frontend PWA -------------------------------------------------------------
# Adresses autorisées à appeler l'API (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Authentification ---------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=10/min

# --- Boutique -----------------------------------------------------------------
BOUTIQUE_NAME=Eden Boutique
CURRENCY=XOF
TIME_ZONE=Africa/Abidjan
MAX_ACTIVE_CASHIERS=3
CASHIER_MAX_DISCOUNT_PERCENT=20
CASHIERS_SEE_ALL_SALES=False
NOTIFY_ADMIN_ON_SALE=True
